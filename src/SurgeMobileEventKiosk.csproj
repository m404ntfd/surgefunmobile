<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SurgeMobileEventKiosk</AssemblyName>
    <RootNamespace>SurgeGuestInformationKiosk</RootNamespace>
    <AssemblyTitle>Surge Guest Information Kiosk</AssemblyTitle>
    <ApplicationIcon>..\assets\SurgeMobile.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>Surge Entertainment</Authors>
    <Product>Surge Guest Information Kiosk</Product>
    <Description>Full-screen Surge guest information kiosk with built-in content, staff controls, and automatic GitHub updates.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UpdateRepositoryUrl)' != ''">
    <AssemblyMetadata Include="UpdateRepositoryUrl" Value="$(UpdateRepositoryUrl)" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="..\assets\GuestKiosk.html">
      <LogicalName>GuestKiosk.html</LogicalName>
    </EmbeddedResource>
    <EmbeddedResource Include="..\assets\SurgeWordmarkWhite.svg">
      <LogicalName>SurgeWordmarkWhite.svg</LogicalName>
    </EmbeddedResource>
  </ItemGroup>
</Project>
