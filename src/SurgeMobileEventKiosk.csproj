<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>SurgeMobileEventKiosk</AssemblyName>
    <RootNamespace>SurgeMobileEventKiosk</RootNamespace>
    <AssemblyTitle>Surge Mobile Event Kiosk</AssemblyTitle>
    <ApplicationIcon>..\assets\SurgeMobile.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Authors>Surge Entertainment</Authors>
    <Product>Surge Mobile Event Kiosk</Product>
    <Description>Full-screen Surge Mobile event request kiosk with staff controls and automatic GitHub updates.</Description>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4129.50" />
    <PackageReference Include="Velopack" Version="1.2.0" />
  </ItemGroup>

  <ItemGroup Condition="'$(UpdateRepositoryUrl)' != ''">
    <AssemblyMetadata Include="UpdateRepositoryUrl" Value="$(UpdateRepositoryUrl)" />
  </ItemGroup>
</Project>
